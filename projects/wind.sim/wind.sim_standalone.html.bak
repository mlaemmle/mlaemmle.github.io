y.csv", "has100": false, "source": "DWD Climate Data Center, Station 3631, Stundenwerte Wind 2025", "note": "Ostfriesische Insel, Nordsee", "filled_hours": 0, "longest_gap_h": 0}, {"slug": "Helgoland", "name": "Helgoland", "group": "Nordsee (Insel)", "lat": 54.175, "lon": 7.892, "altitude": 4.0, "h_ref": 10.0, "year": 2025, "file": "data/Helgoland.csv", "has100": false, "source": "DWD Climate Data Center, Station 2115, Stundenwerte Wind 2025", "note": "Hochseeinsel in der Deutschen Bucht", "filled_hours": 112, "longest_gap_h": 88}, {"slug": "Kiel_Leuchtturm", "name": "Leuchtturm Kiel", "group": "Ostsee (Offshore-nah)", "lat": 54.4996, "lon": 10.2737, "altitude": 0.0, "h_ref": 34.0, "year": 2025, "file": "data/Kiel_Leuchtturm.csv", "has100": false, "source": "DWD Climate Data Center, Station 2961, Stundenwerte Wind 2025", "note": "Leuchtturm in der Kieler Förde, Anemometer in 34 m", "filled_hours": 192, "longest_gap_h": 109}, {"slug": "Arkona", "name": "Kap Arkona (Rügen)", "group": "Ostsee (Küste)", "lat": 54.6791, "lon": 13.4344, "altitude": 42.0, "h_ref": 24.0, "year": 2025, "file": "data/Arkona.csv", "has100": false, "source": "DWD Climate Data Center, Station 183, Stundenwerte Wind 2025", "note": "Nordspitze Rügen, Anemometer in 24 m", "filled_hours": 0, "longest_gap_h": 0}, {"slug": "Freiburg", "name": "Freiburg", "group": "Baden-Württemberg", "lat": 48.0232, "lon": 7.8343, "altitude": 237.0, "h_ref": 12.0, "year": 2025, "file": "data/Freiburg.csv", "has100": false, "source": "DWD Climate Data Center, Station 1443, Stundenwerte Wind 2025", "note": "Oberrheingraben, windarm", "filled_hours": 10, "longest_gap_h": 3}, {"slug": "Feldberg", "name": "Feldberg/Schwarzwald (Ersatz für Schauinsland)", "group": "Baden-Württemberg", "lat": 47.8748, "lon": 8.0038, "altitude": 1486.0, "h_ref": 18.4, "year": 2025, "file": "data/Feldberg.csv", "has100": false, "source": "DWD Climate Data Center, Station 1346, Stundenwerte Wind 2025", "note": "Höchster Gipfel des Schwarzwalds (1486 m); für den Schauinsland liegen keine aktuellen DWD-Winddaten vor", "filled_hours": 0, "longest_gap_h": 0}, {"slug": "Passau", "name": "Passau (Station Fürstenzell)", "group": "Bayern", "lat": 48.5451, "lon": 13.3532, "altitude": 476.0, "h_ref": 12.0, "year": 2025, "file": "data/Passau.csv", "has100": false, "source": "DWD Climate Data Center, Station 5856, Stundenwerte Wind 2025", "note": "Niederbayern, 8 km von Passau, 476 m ü. NN", "filled_hours": 52, "longest_gap_h": 47}, {"slug": "Nordsee_ERA5", "name": "Nordsee – Deutsche Bucht (ERA5)", "group": "Offshore (Reanalyse)", "lat": 54.01, "lon": 6.6, "altitude": 0.0, "h_ref": 10.0, "year": 2025, "file": "data/Nordsee_ERA5.csv", "has100": true, "source": "ERA5-Reanalyse (Copernicus/ECMWF) über Open-Meteo, 2025", "note": "Offshore-Punkt bei alpha ventus (ca. 45 km nördlich von Borkum), ERA5-Reanalyse", "filled_hours": 0, "longest_gap_h": 0}, {"slug": "Ostsee_ERA5", "name": "Ostsee – Arkonabecken (ERA5)", "group": "Offshore (Reanalyse)", "lat": 54.8, "lon": 14.1, "altitude": 0.0, "h_ref": 10.0, "year": 2025, "file": "data/Ostsee_ERA5.csv", "has100": true, "source": "ERA5-Reanalyse (Copernicus/ECMWF) über Open-Meteo, 2025", "note": "Offshore-Punkt nordöstlich von Rügen (Windparkgebiet Arkonabecken), ERA5-Reanalyse", "filled_hours": 0, "longest_gap_h": 0}];
</script>
<script>
'use strict';
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const C = { ink: '#1a1a1a', ink2: '#52514e', muted: '#898781', grid: '#e1e0d9', axis: '#c3c2b7', line: '#e1e0d9',
  blue: '#2a78d6', orange: '#eb6834', aqua: '#1baf7a', yellow: '#eda100', violet: '#6250d6', red: '#e34948' };

let py = null, SITES = [], ANL = [], res = null, running = false, rerun = false, timer = null;
const csvCache = new Map(), wxCache = new Map();
let wxLoaded = null;           // Schlüssel der aktuell in Python geladenen Winddaten
let activeTab = 'year';
const dirty = new Set();
const TABS = ['year', 'month', 'day', 'hour', 'curve', 'dist', 'dir', 'prof', 'heat'];

/* Geländetypen mit typischen Rauhigkeitslängen */
const TERRAINS = [
  [0.0002, 'Wasserflächen: Meer und Seen'],
  [0.0024, 'Offenes Gelände, glatte Oberfläche (Beton, Landebahn, gemähtes Gras)'],
  [0.03, 'Offenes landwirtschaftliches Gelände ohne Zäune und Hecken'],
  [0.055, 'Offenes Gelände mit einigen Häusern und 8 m hohen Hecken (> 1 km Abstand)'],
  [0.1, 'Landwirtschaftliches Gelände mit vielen/hohen Hecken (ca. 500 m Abstand)'],
  [0.2, 'Landwirtschaftliches Gelände mit Häusern, Büschen, Hecken (ca. 250 m)'],
  [0.4, 'Dörfer, Kleinstädte, viele hohe Hecken, Wälder, raues Terrain'],
  [0.6, 'Größere Städte mit hohen Wohngebäuden'],
  [1.6, 'Großstädte mit hohen Gebäuden und Wolkenkratzern'],
];
/* Vorschlag für die Rauhigkeitslänge je Standort (änderbar) */
const Z0_SUGGEST = { Generisch: 0.1, Berlin: 0.4, Hannover: 0.1, Soltau: 0.2, Cuxhaven: 0.03, Norderney: 0.03, Helgoland: 0.0002,
  Kiel_Leuchtturm: 0.0002, Arkona: 0.03, Freiburg: 0.2, Feldberg: 0.1, Passau: 0.2, Nordsee_ERA5: 0.0002, Ostsee_ERA5: 0.0002 };

/* ---------------- Hilfsfunktionen ---------------- */
const fmt = (v, d = 0) => (v === null || v === undefined || Number.isNaN(v)) ? '–'
  : Number(v).toLocaleString('de-DE', { minimumFractionDigits: d, maximumFractionDigits: d });
const fmtAuto = v => { const s = String(v); const d = Math.min(3, (s.split('.')[1] || '').length); return fmt(v, d); };
const num = id => parseFloat($('#' + id).value);
function setStatus(txt, kind = '') { const s = $('#status'); s.className = 'status ' + kind; $('#status-txt').textContent = txt; }
function setOverlay(msg, pct) { $('#ov-msg').textContent = msg; $('#ov-bar').style.width = pct + '%'; }
function download(name, data, type) {
  const url = URL.createObjectURL(new Blob(data, { type }));
  const a = Object.assign(document.createElement('a'), { href: url, download: name });
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 2000);
}

/* ---------------- Profilformeln (identisch zum Python-Modell) ---------------- */
const hellmann = (hh, hr, z0) => 1 / Math.log(Math.sqrt(hh * hr) / z0);
const profFactor = (hh, hr, z0, kind) => kind === 'log' ? Math.log(hh / z0) / Math.log(hr / z0) : Math.pow(hh / hr, hellmann(hh, hr, z0));

/* ---------------- Anlagen-Skizze (SVG) ---------------- */
function turbineSvg(hub, d, href) {
  const G = 165, top = Math.max(hub + d / 2, href, 40), s = 138 / top, X = 150;
  const hy = G - hub * s, R = (d / 2) * s;
  const blade = ang => { const a = ang * Math.PI / 180, ux = Math.sin(a), uy = -Math.cos(a), px = -uy, py2 = ux;
    const bx = X + ux * 4, by = hy + uy * 4, tx = X + ux * R, ty = hy + uy * R;
    return `<path d="M ${bx + px * 3} ${by + py2 * 3} L ${tx} ${ty} L ${bx - px * 3} ${by - py2 * 3} Z" fill="#9ec5f4" stroke="${C.blue}" stroke-width="1.2" stroke-linejoin="round"/>`; };
  const arrow = (x1, y1, x2, y2) => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${C.ink2}" stroke-width="1.2" marker-start="url(#wa)" marker-end="url(#wa)"/>`;
  const mx = 262, mh = G - href * s;
  return `<svg viewBox="0 0 300 190" role="img" aria-label="Skizze: Nabenhöhe ${hub} m, Rotordurchmesser ${d} m, Messhöhe ${href} m">
    <defs><marker id="wa" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="${C.ink2}"/></marker></defs>
    <line x1="8" y1="${G}" x2="292" y2="${G}" stroke="${C.axis}" stroke-width="2"/>
    <circle cx="${X}" cy="${hy}" r="${R}" fill="none" stroke="${C.muted}" stroke-width="1" stroke-dasharray="4 3"/>
    <path d="M ${X - 5} ${G} L ${X - 2.5} ${hy} L ${X + 2.5} ${hy} L ${X + 5} ${G} Z" fill="#c9c8bf"/>
    ${blade(0)}${blade(120)}${blade(240)}
    <circle cx="${X}" cy="${hy}" r="4.5" fill="${C.ink2}"/>
    ${arrow(34, G, 34, hy)}<line x1="30" y1="${hy}" x2="${X - 6}" y2="${hy}" stroke="${C.muted}" stroke-width="1" stroke-dasharray="2 3"/>
    <text x="40" y="${(G + hy) / 2}" font-size="12" font-weight="600" fill="${C.orange}">H</text>
    ${R > 10 ? arrow(X - R, hy - 7, X + R, hy - 7) + `<text x="${X}" y="${hy - 11}" text-anchor="middle" font-size="12" font-weight="600" fill="${C.orange}">D</text>` : ''}
    <line x1="${mx}" y1="${G}" x2="${mx}" y2="${mh}" stroke="${C.muted}" stroke-width="2"/>
    <circle cx="${mx}" cy="${mh}" r="3.5" fill="${C.aqua}"/><line x1="${mx - 9}" y1="${mh}" x2="${mx + 9}" y2="${mh}" stroke="${C.aqua}" stroke-width="2"/>
    <text x="${mx}" y="${mh - 8}" text-anchor="middle" font-size="11" font-weight="600" fill="${C.aqua}">h<tspan font-size="8" dy="2">ref</tspan></text>
    <path d="M 8 ${G - 22} h 26" stroke="${C.ink2}" stroke-width="1.6" marker-end="url(#wa)"/><text x="8" y="${G - 27}" font-size="10" fill="${C.muted}">Wind</text>
  </svg>`;
}
function updateSketch() {
  const h = num('hub') || 100, d = num('rotor') || 0, r = num('href') || 10;
  const hr = $('#use100').checked ? 100 : r;
  $('#svg-turbine').innerHTML = turbineSvg(Math.max(h, 1), Math.max(d, 0), hr);
  $('#cap-turbine').innerHTML = `Nabenhöhe <b>H = ${fmt(h)} m</b> · Rotor <b>D = ${fmt(d)} m</b> · Messhöhe <b>h<sub>ref</sub> = ${fmt(hr)} m</b>`;
}

/* ---------------- Daten laden ---------------- */
function loadScript(src) {
  return new Promise((ok, rej) => {
    const el = document.createElement('script'); el.src = src;
    el.onload = ok; el.onerror = () => rej(new Error('Datei nicht ladbar: ' + src));
    document.head.appendChild(el);
  });
}
async function getData() {
  if (!window.WIND_STANDORTE) await loadScript('data/standorte.js');
  if (!window.WIND_ANLAGEN) await loadScript('data/anlagen.js');
  return [window.WIND_STANDORTE, window.WIND_ANLAGEN];
}
async function getCsv(s) {
  if (!(window.WIND_CSV && window.WIND_CSV[s.file])) await loadScript(s.file.replace(/\.csv$/, '.js'));
  return window.WIND_CSV[s.file];
}

/* ---------------- Eingaben ---------------- */
const curType = () => ANL.find(a => a.id === $('#type').value);
function applyType(keepHub = false) {
  const a = curType(); if (!a) return;
  const gen = a.normalized;
  $('#pn').value = a.p_nom_mw; $('#rotor').value = a.rotor_d;
  $('#pn').disabled = !gen; $('#rotor').disabled = !gen;
  if (!keepHub) { $('#hub').value = a.hub_default; $('#hub-r').value = a.hub_default; }
  $('#hub-hint').textContent = a.hubs && a.hubs.length ? `Herstellerangaben: Nabenhöhen ${a.hubs.map(x => fmt(x, x % 1 ? 1 : 0)).join(' / ')} m` : '';
  $('#type-hint').textContent = (a.note || '').replace(/\.?$/, '.') + (a.extended_to_25 ? ' Die Herstellerkurve endet vor 25 m/s; sie wird bis 25 m/s auf Nennleistung fortgesetzt.' : '');
  updateSketch();
}
function syncTerrain() {
  const z = num('z0'); const sel = $('#terrain');
  const hit = TERRAINS.find(t => Math.abs(t[0] - z) < 1e-9);
  sel.value = hit ? String(hit[0]) : 'custom';
}
function readParams() {
  const errs = [];
  const chk = (id, lo, hi, label) => { const el = $('#' + id), v = parseFloat(el.value);
    const ok = Number.isFinite(v) && v >= lo && v <= hi; el.classList.toggle('bad', !ok); if (!ok) errs.push(`${label}: ${lo} … ${hi}`); return v; };
  const a = curType(); const use100 = $('#use100').checked && !$('#box100').hidden;
  const pn = chk('pn', 0.05, 30, 'Nennleistung'), rotor = chk('rotor', 5, 300, 'Rotordurchmesser');
  const p = {
    hub: chk('hub', 10, 300, 'Nabenhöhe'), z0: chk('z0', 0.0001, 1.6, 'Rauhigkeitslänge'),
    profile: $('input[name=prof]:checked').value, h_ref: use100 ? 100 : chk('href', 1, 200, 'Messhöhe'), use100,
    density: $('#density').checked, loss_pct: chk('loss', 0, 50, 'Verluste'),
    p_nom_mw: pn, rotor_d: rotor, curve_name: a.name,
    curve: { v: a.v, p: a.normalized ? a.p.map(x => x * pn) : a.p },
  };
  return { p, errs };
}

/* ---------------- Standorte & Winddaten ---------------- */
async function loadSource() {
  const val = $('#src').value, custom = val === 'custom';
  $('#custom-box').hidden = !custom;
  if (custom) {
    $('#box100').hidden = false; $('#src-hint').textContent = 'Eigener Standort: stündliche ERA5-Reanalyse über Open-Meteo (kostenlos, ohne API-Key). Rasterdaten glätten das Relief; für Gipfel- und Küstenlagen sind Messungen besser. Bitte Gelände (Rauhigkeitslänge) und Anlage passend zum Ort einstellen.';
    $('#data-note').textContent = '';
    if (wxLoaded && wxLoaded.startsWith('om:')) { $('#href').value = 10; return scheduleRun(); }
    $('#wx-hint').textContent = 'Koordinaten eingeben bzw. Ort suchen, dann „Winddaten abrufen“.';
    return;
  }
  const s = SITES.find(x => x.slug === val);
  $('#href').value = s.h_ref; $('#box100').hidden = !s.has100; if (!s.has100) $('#use100').checked = false;
  if (Z0_SUGGEST[s.slug] != null) { $('#z0').value = Z0_SUGGEST[s.slug]; syncTerrain(); }
  $('#href').disabled = false; updateSketch();
  const gaps = s.filled_hours > 0 ? ` Datenlücken: ${fmt(s.filled_hours)} Stunden (längste ${fmt(s.longest_gap_h)} h) linear interpoliert.` : '';
  $('#src-hint').textContent = `${s.note}. Messhöhe laut Stationsmetadaten: ${fmt(s.h_ref, 1)} m.${s.has100 ? ' ERA5 liefert zusätzlich Wind in 100 m.' : ''} Rauhigkeitslänge auf Vorschlag gesetzt (änderbar).`;
  $('#data-note').textContent = `Datenquelle: ${s.source}.${gaps}`;
  setStatus(`Lade Winddaten ${s.name} …`, 'busy');
  try {
    const txt = await getCsv(s);
    py.globals.get('load_csv')(txt, JSON.stringify({ name: s.name, lat: s.lat, lon: s.lon, altitude: s.altitude, source: s.source,
      year: s.year, year_label: String(s.year), filled_hours: s.filled_hours, h_ref: s.h_ref }));
    wxLoaded = 'csv:' + s.slug; scheduleRun(0);
  } catch (e) { fail(e, 'Die Datendatei konnte nicht geladen werden. Liegt der Ordner „data“ neben der HTML-Datei? Alternativ wind_sim_standalone.html verwenden.'); }
}
async function fetchOpenMeteo() {
  const lat = num('lat'), lon = num('lon'), year = $('#wx-year').value;
  if (!(lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180)) { $('#wx-hint').textContent = 'Bitte gültige Koordinaten eingeben.'; $('#wx-hint').className = 'hint err'; return; }
  const key = `om:${lat.toFixed(3)},${lon.toFixed(3)},${year}`;
  $('#wx-hint').className = 'hint'; $('#wx-hint').textContent = 'Rufe Open-Meteo ab …'; $('#wx-fetch').disabled = true;
  setStatus('Rufe Winddaten von Open-Meteo ab …', 'busy');
  try {
    let txt = wxCache.get(key);
    if (!txt) {
      const u = `https://archive-api.open-meteo.com/v1/archive?latitude=${lat}&longitude=${lon}&start_date=${year}-01-01&end_date=${year}-12-31`
        + `&hourly=wind_speed_10m,wind_direction_10m,wind_speed_100m,wind_direction_100m&wind_speed_unit=ms&timezone=GMT`;
      const r = await fetch(u); const t = await r.text();
      if (!r.ok) throw new Error('Open-Meteo: ' + (JSON.parse(t).reason || r.status));
      txt = t; wxCache.set(key, txt);
    }
    const elev = JSON.parse(txt).elevation ?? 0;
    const n = py.globals.get('load_openmeteo')(txt, JSON.stringify({ name: `Eigener Standort (${lat.toFixed(3)}, ${lon.toFixed(3)})`, lat, lon, altitude: elev,
      source: 'ERA5-Reanalyse (Copernicus/ECMWF) über Open-Meteo', year_label: String(year), filled_hours: 0, h_ref: 10 }));
    wxLoaded = key; $('#href').value = 10; $('#wx-hint').textContent = `Geladen: ${fmt(n)} Stunden, Jahr ${year} (Geländehöhe im Modell ${fmt(elev)} m).`;
    $('#data-note').textContent = 'Datenquelle: ERA5-Reanalyse (Copernicus/ECMWF) über Open-Meteo, CC BY 4.0.'; updateSketch(); scheduleRun(0);
  } catch (e) { $('#wx-hint').className = 'hint err'; $('#wx-hint').textContent = String(e.message || e); fail(e); }
  finally { $('#wx-fetch').disabled = false; }
}
async function geocode() {
  const q = $('#geo-q').value.trim(); if (!q) return;
  const box = $('#geo-res'); box.textContent = 'Suche …';
  try {
    const r = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(q)}&count=5&language=de&format=json`);
    const j = await r.json(); box.innerHTML = '';
    if (!j.results) { box.textContent = 'Kein Treffer.'; return; }
    j.results.forEach(o => { const b = document.createElement('button'); b.type = 'button';
      b.textContent = `${o.name}${o.admin1 ? ', ' + o.admin1 : ''}, ${o.country || ''} (${o.latitude.toFixed(3)}, ${o.longitude.toFixed(3)})`;
      b.onclick = () => { $('#lat').value = o.latitude.toFixed(4); $('#lon').value = o.longitude.toFixed(4); box.innerHTML = '';
        $('#wx-hint').textContent = 'Koordinaten übernommen – jetzt „Winddaten abrufen“.'; $('#wx-hint').className = 'hint'; };
      box.appendChild(b); });
  } catch (e) { box.textContent = 'Suche fehlgeschlagen: ' + e.message; }
}

/* ---------------- Rechnen ---------------- */
function scheduleRun(delay = 220) { clearTimeout(timer); timer = setTimeout(run, delay); }
async function run() {
  if (!py || !wxLoaded) return;
  if (running) { rerun = true; return; }
  const { p, errs } = readParams();
  if (errs.length) { setStatus('Bitte Eingaben prüfen – ' + errs.join(' · '), 'err'); return; }
  if ($('#src').value === 'custom' && !wxLoaded.startsWith('om:')) { setStatus('Bitte zuerst Winddaten abrufen.', 'err'); return; }
  const hint = $('#prof-hint'); hint.className = 'hint';
  hint.textContent = (p.profile === 'log' && p.hub > 100) ? 'Hinweis: Das logarithmische Profil ist bei Nabenhöhen über 100 m nicht zu empfehlen.' : '';
  if (hint.textContent) hint.className = 'hint warn';
  running = true; setStatus('Berechne …', 'busy');
  await new Promise(r => setTimeout(r, 15));
  try {
    const t0 = performance.now();
    res = JSON.parse(py.globals.get('simulate')(JSON.stringify(p)));
    const y0 = res.daily.dates[0].slice(0, 4); if (!$('#h-start').value.startsWith(y0)) $('#h-start').value = y0 + '-01-06';
    setStatus(`Berechnet in ${fmt((performance.now() - t0) / 1000, 2)} s · ${fmt(res.kpi.hours)} Stunden · ${res.kpi.source}`, '');
    $$('[data-csv], #dl-xlsx, #dl-kpi').forEach(b => b.disabled = false);
    renderTiles(); TABS.forEach(t => dirty.add(t)); renderTab(activeTab);
  } catch (e) { fail(e); }
  finally { running = false; if (rerun) { rerun = false; scheduleRun(0); } }
}
function fail(e, extra = '') {
  console.error(e); const m = String(e.message || e).split('\n').filter(Boolean).slice(-1)[0];
  setStatus('Fehler: ' + m + (extra ? ' – ' + extra : ''), 'err');
}

/* ---------------- Darstellung ---------------- */
function renderTiles() {
  const k = res.kpi;
  const T = (kk, v, u, s) => `<div class="tile"><div class="k">${kk}</div><div class="v">${v}<small>${u}</small></div><div class="s">${s}</div></div>`;
  $('#tiles').innerHTML =
    T('Jahresertrag', fmt(k.yield_mwh), 'MWh', `bei ${fmt(k.p_nom_mw, 2)} MW Nennleistung`) +
    T('Volllaststunden', fmt(k.flh), 'h', `Auslastungsfaktor ${fmt(k.cf, 1)} %`) +
    T('Ø Windgeschwindigkeit', fmt(k.v_hub_mean, 2), 'm/s', `Nabenhöhe ${fmt(k.hub)} m · Messhöhe ${fmt(k.h_ref, 1)} m: ${fmt(k.v_ref_mean, 2)} m/s`) +
    T('Betriebsstunden', fmt(k.op_h), 'h', `${fmt(k.op_h / k.hours * 100, 0)} % des Jahres · ${fmt(k.nom_h)} h bei Nennleistung`);
}
function table(el, cols, rows, decs) {
  const th = cols.map(c => `<th>${c.trim()}</th>`).join('');
  const body = rows.map(r => '<tr>' + r.map((v, i) => `<td>${typeof v === 'number' ? fmt(v, decs[i] ?? 1) : (v ?? '–')}</td>`).join('') + '</tr>').join('');
  el.innerHTML = `<table class="data"><thead><tr>${th}</tr></thead><tbody>${body}</tbody></table>`;
}
const CFG = { responsive: true, displaylogo: false, modeBarButtonsToRemove: ['lasso2d', 'select2d'] };
function baseLayout(extra = {}) {
  return Object.assign({
    font: { family: 'system-ui,-apple-system,"Segoe UI",sans-serif', size: 12, color: C.ink2 },
    paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)', separators: ',.',
    margin: { l: 66, r: 14, t: 34, b: 50 },
    hoverlabel: { bgcolor: '#fff', bordercolor: C.axis, font: { color: C.ink, size: 12 } },
    legend: { orientation: 'h', x: 0, y: 1.14, font: { color: C.ink2 } },
    xaxis: { gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, zeroline: false },
    yaxis: { gridcolor: C.grid, linecolor: 'rgba(0,0,0,0)', tickfont: { color: C.ink2 }, zeroline: false, title: { font: { color: C.ink2 } } },
  }, extra);
}
const ax = (dom, title, extra = {}) => Object.assign({ domain: dom, gridcolor: C.grid, linecolor: 'rgba(0,0,0,0)', zeroline: false, tickfont: { color: C.ink2 }, title: { text: title, font: { color: C.ink2 } } }, extra);
const bar = (x, y, name, color, unit, d = 1, extra = {}) => Object.assign({
  type: 'bar', x, y, name, marker: { color }, hovertemplate: `%{x}<br><b>%{y:,.${d}f}</b> ${unit}<extra>${name}</extra>` }, extra);
const MN = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];

let theoryDone = false;
function renderTheory(tries = 0) {   // Formeln (KaTeX) einmalig setzen; KaTeX lädt asynchron vom CDN
  if (theoryDone) return;
  if (!window.renderMathInElement) { if (tries < 40) setTimeout(() => renderTheory(tries + 1), 250); return; }
  renderMathInElement($('#p-theory'), { delimiters: [{ left: '\\[', right: '\\]', display: true }, { left: '\\(', right: '\\)', display: false }], throwOnError: false });
  theoryDone = true;
}
function vline(x, label, color = C.muted) {
  return { shape: { type: 'line', xref: 'x', yref: 'paper', x0: x, x1: x, y0: 0, y1: 1, line: { color, width: 1, dash: 'dot' } },
    ann: { x, xref: 'x', y: 1, yref: 'paper', text: label, showarrow: false, yanchor: 'top', xanchor: 'left', xshift: 4, font: { size: 11, color: C.ink2 } } };
}
function polar(title, unit) {
  return { polar: { bgcolor: 'rgba(0,0,0,0)', angularaxis: { direction: 'clockwise', rotation: 90, tickmode: 'array', tickvals: [0, 45, 90, 135, 180, 225, 270, 315],
    ticktext: ['N', 'NO', 'O', 'SO', 'S', 'SW', 'W', 'NW'], gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 } },
    radialaxis: { gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2, size: 10 }, ticksuffix: ' ' + unit, angle: 90 } } };
}
function renderTab(t) {
  if (t === 'theory') return renderTheory();
  if (!res || !dirty.has(t)) return; dirty.delete(t);
  const k = res.kpi, tb = res.tables;
  if (t === 'year') {
    $('#year-sub').textContent = `${k.source} · ${k.year_label}`;
    const groups = {}; res.kpi_rows.forEach(r => (groups[r[0]] ||= []).push(r));
    $('#kpi-groups').innerHTML = Object.entries(groups).map(([g, rows]) => `<div class="kpi-group"><h3>${g}</h3><table>` +
      rows.map(r => `<tr><td>${r[1]}</td><td class="n">${typeof r[2] === 'number' ? fmtAuto(r[2]) : r[2]}</td><td class="u">${r[3]}</td></tr>`).join('') + '</table></div>').join('');
    const lg = $('input[name=prof]:checked').value === 'log';
    $('#methods').innerHTML = [
      `Winddaten: ${k.source}; Stundenmittelwerte in ${fmt(k.h_ref, 1)} m Höhe, Zeitstempel in UTC.`,
      lg ? `Höhenprofil: logarithmisch, v(h) = v(h<sub>ref</sub>)·ln(h/z<sub>0</sub>)/ln(h<sub>ref</sub>/z<sub>0</sub>) mit z<sub>0</sub> = ${fmt(k.z0, 4)} m (Faktor ${fmt(k.profile_factor, 3)}).`
         : `Höhenprofil: Hellmann, v(h) = v(h<sub>ref</sub>)·(h/h<sub>ref</sub>)<sup>α</sup> mit α = 1/ln(√(h·h<sub>ref</sub>)/z<sub>0</sub>) = ${fmt(k.alpha, 3)} (z<sub>0</sub> = ${fmt(k.z0, 4)} m, Faktor ${fmt(k.profile_factor, 3)}).`,
      'Leistung: lineare Interpolation der Leistungskennlinie; Stundenmittel [kW] × 1 h = Ertrag [kWh]. Außerhalb der Kennlinie (unter Einschalt-, über Abschaltgeschwindigkeit) ist die Leistung 0.',
      `Luftdichte ρ = ${fmt(k.rho, 3)} kg/m³ (${$('#density').checked ? 'Standardatmosphäre, korrigiert' : 'Normdichte, keine Korrektur'}).`,
      'Tages- und Monatswerte werden in UTC aggregiert.',
    ].map(s => `<li>${s}</li>`).join('');
  }
  if (t === 'month' || t === 'day') {
    const d = t === 'month' ? res.monthly : res.daily, x = t === 'month' ? d.labels : d.dates, v = $('#' + t + '-metric').value;
    const L = baseLayout(t === 'month' ? { barmode: 'group', bargap: .3 } : { barmode: 'group', bargap: .15 });
    let tr, dd = t === 'month' ? 0 : 1;
    if (v === 'yield') { tr = [bar(x, d.yield_mwh, 'Stromertrag', C.blue, 'MWh', t === 'month' ? 1 : 2)]; L.yaxis.title.text = 'Stromertrag [MWh]'; }
    if (v === 'flh') { tr = [bar(x, d.flh, 'Volllaststunden', C.blue, 'h', t === 'month' ? 0 : 1)]; L.yaxis.title.text = 'Volllaststunden [h]'; }
    if (v === 'cf') { tr = [bar(x, d.cf, 'Auslastungsfaktor', C.blue, '%', 1)]; L.yaxis.title.text = 'Auslastungsfaktor [%]'; }
    if (v === 'op') { tr = [bar(x, d.op_h, 'Betriebsstunden', C.blue, 'h', 0)]; L.yaxis.title.text = 'Betriebsstunden [h]'; }
    if (v === 'wind') {
      tr = t === 'month' ? [bar(x, d.v_ref, `Messhöhe (${fmt(k.h_ref, 1)} m)`, C.muted, 'm/s', 2), bar(x, d.v_hub, `Nabenhöhe (${fmt(k.hub)} m)`, C.orange, 'm/s', 2)]
        : [bar(x, d.v_hub, 'Nabenhöhe', C.orange, 'm/s', 2)];
      L.yaxis.title.text = 'Ø Windgeschwindigkeit [m/s]'; }
    L.showlegend = tr.length > 1; L.yaxis.rangemode = 'tozero';
    if (t === 'day') {
      L.xaxis.rangeslider = { visible: true, thickness: .07 }; L.xaxis.type = 'date';
      L.xaxis.rangeselector = { buttons: [{ count: 1, label: '1 M', step: 'month', stepmode: 'backward' }, { count: 3, label: '3 M', step: 'month', stepmode: 'backward' },
        { count: 6, label: '6 M', step: 'month', stepmode: 'backward' }, { step: 'all', label: 'Jahr' }], font: { color: C.ink2 }, bgcolor: '#fafafa', activecolor: '#e8f1fc' };
      L.margin.b = 40;
    }
    Plotly.react('chart-' + t, tr, L, CFG);
    if (t === 'month') table($('#tbl-month'), tb.monthly_cols, tb.monthly_rows, [0, 2, 2, 1, 1, 0, 1, 0]);
    else table($('#tbl-day'), tb.daily_cols, tb.daily_rows, [0, 2, 2, 1, 1, 0]);
  }
  if (t === 'hour') {
    const h = res.hourly, x = h.t;
    const tr = [
      { type: 'scatter', mode: 'lines', x, y: h.p_kw, name: 'Leistung', xaxis: 'x', yaxis: 'y', line: { color: C.blue, width: 1.4 }, fill: 'tozeroy', fillcolor: 'rgba(42,120,214,.16)', hovertemplate: '%{y:,.0f} kW<extra>Leistung</extra>' },
      { type: 'scatter', mode: 'lines', x, y: h.v_hub, name: `Windgeschwindigkeit Nabenhöhe (${fmt(k.hub)} m)`, xaxis: 'x2', yaxis: 'y2', line: { color: C.orange, width: 1.4 }, hovertemplate: '%{y:,.1f} m/s<extra>Nabenhöhe</extra>' },
      { type: 'scatter', mode: 'lines', x, y: h.v_ref, name: `Windgeschwindigkeit Messhöhe (${fmt(k.h_ref, 1)} m)`, xaxis: 'x2', yaxis: 'y2', line: { color: C.muted, width: 1.2 }, hovertemplate: '%{y:,.1f} m/s<extra>Messhöhe</extra>' },
      { type: 'scatter', mode: 'markers', x, y: h.wd, name: 'Windrichtung', xaxis: 'x3', yaxis: 'y3', marker: { color: C.violet, size: 3 }, hovertemplate: '%{y:.0f}°<extra>Windrichtung</extra>' },
    ];
    const L = baseLayout({ hovermode: 'x unified', margin: { l: 70, r: 14, t: 34, b: 40 },
      xaxis: { anchor: 'y', matches: 'x3', showticklabels: false, gridcolor: C.grid, linecolor: C.axis },
      xaxis2: { anchor: 'y2', matches: 'x3', showticklabels: false, gridcolor: C.grid, linecolor: C.axis },
      xaxis3: { anchor: 'y3', type: 'date', gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, title: { text: 'Zeit (UTC)', font: { color: C.ink2 } }, rangeslider: { visible: true, thickness: .06 } },
      yaxis: ax([.72, 1], 'Leistung [kW]', { rangemode: 'tozero' }), yaxis2: ax([.38, .66], 'Wind [m/s]', { rangemode: 'tozero' }),
      yaxis3: ax([.08, .32], 'Richtung [°]', { range: [0, 360], tickvals: [0, 90, 180, 270, 360], ticktext: ['N', 'O', 'S', 'W', 'N'] }) });
    L.legend = { orientation: 'h', x: 0, y: 1.07, font: { color: C.ink2 } };
    setHourRange(L);
    Plotly.react('chart-hour', tr, L, CFG);
    table($('#tbl-hour'), tb.hourly_cols, tb.hourly_preview, tb.hourly_cols.map((_, i) => i === 0 ? 0 : 1));
    $('#hour-note').textContent = `Vorschau: erste ${tb.hourly_preview.length} von ${fmt(k.hours)} Stunden – der CSV-/Excel-Download enthält alle Stunden.`;
  }
  if (t === 'curve') {
    const c = res.curve, vmaxAx = Math.max(30, Math.ceil(c.v_out) + 2), hasCp = !!c.cp;
    $('#curve-note').innerHTML = `Einschaltgeschwindigkeit ${fmt(c.v_in, 1)} m/s · Nenngeschwindigkeit ${fmt(c.v_rated, 1)} m/s · Abschaltgeschwindigkeit ${fmt(c.v_out, 1)} m/s · ${res.kpi.p_nom_mw ? 'Nennleistung ' + fmt(res.kpi.p_nom_mw, 2) + ' MW' : ''}. Leistungsbeiwert c<sub>P</sub> = P / P₀ mit der Leistung des Windes P₀ = ½ρAv³ (= ½ṁv², ṁ = ρAv). P₀ steigt mit v³ und verlässt das Diagramm; die Anlage nutzt davon höchstens den Betz-Anteil.`;
    const lines = [vline(c.v_in, 'v min'), vline(c.v_rated, 'v Nenn'), vline(c.v_out, 'v max')];
    const hr = res.hourly;
    const tr = [];
    if (c.pw_kw) {
      tr.push({ type: 'scatter', mode: 'lines', x: c.v, y: c.pw_kw, name: 'Leistung des Windes P₀ = ½ρAv³', xaxis: 'x', yaxis: 'y', line: { color: C.orange, width: 2 },
        hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.0f}</b> kW<extra>Windleistung</extra>' });
      tr.push({ type: 'scatter', mode: 'lines', x: c.v, y: c.betz_kw, name: 'Betz-Grenze (16/27 · P₀)', xaxis: 'x', yaxis: 'y', line: { color: C.red, width: 1.6, dash: 'dash' },
        hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.0f}</b> kW<extra>Betz-Grenze</extra>' });
    }
    tr.push({ type: 'scatter', mode: 'lines', x: c.v, y: c.p_kw, name: 'Leistungskurve der Anlage', xaxis: 'x', yaxis: 'y', line: { color: C.blue, width: 2.4 },
      hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.0f}</b> kW<extra>Leistungskurve</extra>' });
    const L = baseLayout({ margin: { l: 70, r: 14, t: 110, b: 50 }, showlegend: true,
      xaxis: { anchor: hasCp ? 'y2' : 'y', range: [0, vmaxAx], gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, title: { text: 'Windgeschwindigkeit in Nabenhöhe [m/s]', font: { color: C.ink2 } } },
      yaxis: ax(hasCp ? [.4, 1] : [0, 1], 'Leistung [kW]', { range: [0, 1.5 * c.p_nom_kw] }) });
    L.legend = { orientation: 'h', x: 0, y: 1.02, yanchor: 'bottom', font: { color: C.ink2 } };
    if (hasCp) {
      tr.push({ type: 'scatter', mode: 'lines', x: c.v, y: c.cp, name: 'Leistungsbeiwert', showlegend: false, xaxis: 'x', yaxis: 'y2', line: { color: C.orange, width: 2 }, hovertemplate: '%{x:.1f} m/s<br><b>c<sub>P</sub> = %{y:.3f}</b><extra></extra>' });
      L.yaxis2 = ax([0, .3], 'Leistungsbeiwert c<sub>P</sub> [–]', { range: [0, 0.7], dtick: 0.2 });
    }
    L.shapes = lines.map(l => l.shape); L.annotations = lines.map(l => l.ann);
    if (hasCp) {
      L.shapes.push({ type: 'line', xref: 'x', yref: 'y2', x0: 0, x1: vmaxAx, y0: 16 / 27, y1: 16 / 27, line: { color: C.red, width: 1.2, dash: 'dash' } });
      L.annotations.push({ x: vmaxAx, xref: 'x', y: 16 / 27, yref: 'y2', text: 'Betz-Grenze 0,593', showarrow: false, xanchor: 'right', yanchor: 'bottom', font: { size: 11, color: C.red } });
    }
    Plotly.react('chart-curve', tr, L, CFG);
    // Leistungskurve + Histogramm + Ertrag je Klasse
    const d = res.dist, cx = d.edges.slice(0, -1).map(e => e + 0.5);
    const tr2 = [
      { type: 'bar', x: cx, y: d.hours, name: 'Häufigkeit', xaxis: 'x', yaxis: 'y', marker: { color: C.orange }, width: 0.9, hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.0f}</b> h<extra>Häufigkeit</extra>' },
      { type: 'scatter', mode: 'markers', x: hr.v_hub, y: hr.p_kw, name: 'Stundenwerte', xaxis: 'x2', yaxis: 'y2',
        marker: { color: C.aqua, size: 5, opacity: .35 }, hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.0f}</b> kW<extra>Stunde</extra>' },
      { type: 'scatter', mode: 'lines', x: c.v, y: c.p_kw, name: 'Leistung', xaxis: 'x2', yaxis: 'y2', line: { color: C.blue, width: 2 }, hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.0f}</b> kW<extra>Leistung</extra>' },
      { type: 'bar', x: cx, y: d.yield_mwh, name: 'Ertrag', xaxis: 'x3', yaxis: 'y3', marker: { color: C.aqua }, width: 0.9, hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.1f}</b> MWh<extra>Ertrag</extra>' },
    ];
    const L2 = baseLayout({ margin: { l: 74, r: 14, t: 18, b: 50 }, showlegend: false,
      xaxis: { anchor: 'y', range: [0, vmaxAx], matches: 'x3', showticklabels: false, gridcolor: C.grid, linecolor: C.axis },
      xaxis2: { anchor: 'y2', range: [0, vmaxAx], matches: 'x3', showticklabels: false, gridcolor: C.grid, linecolor: C.axis },
      xaxis3: { anchor: 'y3', range: [0, vmaxAx], gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, title: { text: 'Windgeschwindigkeit in Nabenhöhe [m/s]', font: { color: C.ink2 } } },
      yaxis: ax([.72, 1], 'Häufigkeit [h/Jahr]', { rangemode: 'tozero' }), yaxis2: ax([.38, .66], 'Leistung [kW]', { rangemode: 'tozero' }),
      yaxis3: ax([0, .3], 'Ertrag [MWh]', { rangemode: 'tozero' }) });
    Plotly.react('chart-curve-hist', tr2, L2, CFG);
  }
  if (t === 'dist') {
    const d = res.dist, cx = d.edges.slice(0, -1).map(e => e + 0.5);
    $('#dist-note').innerHTML = `Weibull: k = ${fmt(k.weibull_k, 2)}, A = ${fmt(k.weibull_a, 2)} m/s · Ø v = ${fmt(k.v_hub_mean, 2)} m/s · Ertrag aus Weibull ${fmt(k.e_weibull_mwh)} MWh, aus Rayleigh ${fmt(k.e_rayleigh_mwh)} MWh, aus Zeitreihe ${fmt(k.yield_mwh)} MWh.`;
    const tr = [
      { type: 'bar', x: cx, y: d.hours, name: 'Zeitreihe (Histogramm)', marker: { color: C.blue }, width: 0.9, hovertemplate: '%{x:.1f} m/s<br><b>%{y:,.0f}</b> h<extra>Zeitreihe</extra>' },
      { type: 'scatter', mode: 'lines', x: cx, y: d.fit_weibull, name: `Weibull (k = ${fmt(k.weibull_k, 2)}, A = ${fmt(k.weibull_a, 2)} m/s)`, line: { color: C.orange, width: 2.2 }, hovertemplate: '%{y:,.0f} h<extra>Weibull</extra>' },
      { type: 'scatter', mode: 'lines', x: cx, y: d.fit_rayleigh, name: 'Rayleigh (k = 2)', line: { color: C.violet, width: 2, dash: 'dash' }, hovertemplate: '%{y:,.0f} h<extra>Rayleigh</extra>' },
    ];
    const L = baseLayout({ margin: { l: 70, r: 14, t: 34, b: 50 }, xaxis: { range: [0, Math.max(...d.edges.slice(0, -1).filter((e, i) => d.hours[i] > 0)) + 2], gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, title: { text: 'Windgeschwindigkeit in Nabenhöhe [m/s]', font: { color: C.ink2 } } } });
    L.yaxis.title.text = 'Stunden pro Jahr [h] je Klasse (1 m/s)'; L.yaxis.rangemode = 'tozero'; L.hovermode = 'x unified';
    Plotly.react('chart-dist', tr, L, CFG);
    const du = res.duration, xs = du.map((_, i) => i + 1);
    const L2 = baseLayout({ margin: { l: 70, r: 14, t: 18, b: 50 }, showlegend: false, xaxis: { gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, title: { text: 'Stunden des Jahres (sortiert)', font: { color: C.ink2 } } } });
    L2.yaxis.title.text = 'Leistung [kW]'; L2.yaxis.rangemode = 'tozero';
    Plotly.react('chart-dur', [{ type: 'scatter', mode: 'lines', x: xs, y: du, line: { color: C.blue, width: 2 }, fill: 'tozeroy', fillcolor: 'rgba(42,120,214,.16)', hovertemplate: 'Stunde %{x:,.0f}<br><b>%{y:,.0f}</b> kW<extra></extra>' }], L2, CFG);
  }
  if (t === 'dir') {
    const d = res.dir, base = (unit, title) => Object.assign(baseLayout({ margin: { l: 30, r: 30, t: 20, b: 30 }, showlegend: false }), polar(title, unit));
    const bp = (r, color, unit, dd) => [{ type: 'barpolar', theta: d.sectors, r, width: 10, marker: { color, line: { color: '#fff', width: 1 } }, hovertemplate: `%{theta}°<br><b>%{r:,.${dd}f}</b> ${unit}<extra></extra>` }];
    Plotly.react('chart-dir-share', bp(d.share, C.blue, '%', 1), base('%', ''), CFG);
    Plotly.react('chart-dir-v', bp(d.v, C.orange, 'm/s', 2), base('m/s', ''), CFG);
    Plotly.react('chart-dir-e', bp(d.yield_mwh, C.aqua, 'MWh', 1), base('MWh', ''), CFG);
  }
  if (t === 'prof') {
    const p = res.profile, kind = $('input[name=prof]:checked').value, sel = kind === 'log' ? 'log' : 'exp';
    $('#prof-note').textContent = `Mittlere Windgeschwindigkeit in ${fmt(p.h_ref, 1)} m: ${fmt(p.v_ref, 2)} m/s → in ${fmt(p.hub)} m (Nabenhöhe): ${fmt(p.v_ref * profFactor(p.hub, p.h_ref, k.z0, kind), 2)} m/s (z₀ = ${fmt(k.z0, 4)} m).`;
    const tr = [
      { type: 'scatter', mode: 'lines', x: p.exp, y: p.h, name: 'Exponentiell (Hellmann)', line: { color: C.orange, width: sel === 'exp' ? 2.6 : 1.6, dash: sel === 'exp' ? 'solid' : 'dot' }, hovertemplate: '%{y:.0f} m: <b>%{x:.2f}</b> m/s<extra>Hellmann</extra>' },
      { type: 'scatter', mode: 'lines', x: p.log, y: p.h, name: 'Logarithmisch', line: { color: C.blue, width: sel === 'log' ? 2.6 : 1.6, dash: sel === 'log' ? 'solid' : 'dot' }, hovertemplate: '%{y:.0f} m: <b>%{x:.2f}</b> m/s<extra>Logarithmisch</extra>' },
      { type: 'scatter', mode: 'markers+text', x: [p.v_ref, p.v_ref * profFactor(p.hub, p.h_ref, k.z0, kind)], y: [p.h_ref, p.hub], text: ['Messhöhe', 'Nabenhöhe'], textposition: ['middle right', 'middle right'],
        marker: { size: 9, color: [C.aqua, C.ink], line: { color: '#fff', width: 1.5 } }, showlegend: false, hoverinfo: 'skip', textfont: { color: C.ink2 } },
    ];
    const L = baseLayout({ margin: { l: 64, r: 14, t: 34, b: 50 }, xaxis: { gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, rangemode: 'tozero', title: { text: 'Windgeschwindigkeit [m/s]', font: { color: C.ink2 } } } });
    L.yaxis.title.text = 'Höhe über Grund [m]'; L.yaxis.range = [0, 250];
    Plotly.react('chart-prof', tr, L, CFG);
    const cols = [C.blue, C.orange, C.aqua, C.yellow, C.violet, C.red];
    const zs = [0.0002, 0.03, 0.1, 0.4, 1.6].filter(z => z < p.h_ref);
    const tr2 = zs.map((z, i) => ({ type: 'scatter', mode: 'lines', name: `z₀ = ${fmt(z, z < 0.01 ? 4 : 2)} m`, y: p.h.filter(h => h > z), x: p.h.filter(h => h > z).map(h => p.v_ref * profFactor(h, p.h_ref, z, kind)),
      line: { color: cols[i], width: 2 }, hovertemplate: `%{y:.0f} m: <b>%{x:.2f}</b> m/s<extra>z₀ = ${z} m</extra>` }));
    const L2 = baseLayout({ margin: { l: 64, r: 14, t: 34, b: 50 }, xaxis: { gridcolor: C.grid, linecolor: C.axis, tickfont: { color: C.ink2 }, rangemode: 'tozero', title: { text: 'Windgeschwindigkeit [m/s]', font: { color: C.ink2 } } } });
    L2.yaxis.title.text = 'Höhe über Grund [m]'; L2.yaxis.range = [0, 250];
    Plotly.react('chart-prof2', tr2, L2, CFG);
  }
  if (t === 'heat') {
    const hm = res.heat, yr = hm.dates[0].slice(0, 4);
    const L = baseLayout({ margin: { l: 56, r: 10, t: 14, b: 40 } });
    L.xaxis = Object.assign(L.xaxis, { type: 'date', tickvals: MN.map((_, i) => `${yr}-${String(i + 1).padStart(2, '0')}-16`), ticktext: MN });
    L.yaxis = Object.assign(L.yaxis, { title: { text: 'Stunde des Tages (Beginn des Intervalls, UTC)', font: { color: C.ink2 } }, dtick: 2, range: [-0.5, 23.5] });
    Plotly.react('chart-heat', [{ type: 'heatmap', x: hm.dates, y: [...Array(24).keys()], z: hm.z, hoverongaps: false,
      colorscale: [[0, '#f4f8fd'], [.12, '#cde2fb'], [.3, '#86b6ef'], [.5, '#3987e5'], [.7, '#1c5cab'], [1, '#0d366b']],
      colorbar: { title: { text: 'kWh', side: 'top' }, thickness: 12, tickfont: { color: C.ink2 } },
      hovertemplate: '%{x|%d.%m.}  %{y}:00 Uhr<br><b>%{z:,.0f}</b> kWh<extra></extra>' }], L, CFG);
  }
}
function setHourRange(L) {
  const start = $('#h-start').value; const span = Number($('#p-hour .chip.on')?.dataset.span ?? 7);
  if (!start || !span) return;
  const a = new Date(start + 'T00:00:00Z'), b = new Date(a.getTime() + span * 864e5);
  const f = d => d.toISOString().slice(0, 16).replace('T', ' ');
  L.xaxis3.range = [f(a), f(b)];
}

/* ---------------- Downloads ---------------- */
function baseName() {
  const k = res.kpi, src = $('#src').value === 'custom' ? `lat${num('lat').toFixed(2)}_lon${num('lon').toFixed(2)}` : $('#src').value;
  return `windsim_${src}_${Math.round(k.p_nom_mw * 100) / 100}MW_${Math.round(k.hub)}m`;
}
function downloadCsv(kind) {
  const names = { hourly: 'stundenwerte', daily: 'tageswerte', monthly: 'monatswerte' };
  download(`${baseName()}_${names[kind]}.csv`, ['﻿', py.globals.get('get_csv')(kind)], 'text/csv;charset=utf-8');
}
function downloadKpi() {
  const q = v => `"${String(v ?? '').replace(/"/g, '""')}"`;
  const rows = [['Gruppe', 'Kennzahl', 'Wert', 'Einheit'], ...res.kpi_rows.map(r => [r[0], r[1].trim(), typeof r[2] === 'number' ? String(r[2]).replace('.', ',') : r[2], r[3]])];
  download(`${baseName()}_jahreswerte.csv`, ['﻿', rows.map(r => r.map(q).join(';')).join('\n')], 'text/csv;charset=utf-8');
}
async function downloadXlsx() {
  const b = $('#dl-xlsx'); const old = b.textContent; b.disabled = true; b.textContent = 'Erzeuge Excel-Datei …';
  try {
    if (!py.globals.get('_xlsx_ready')) { await py.runPythonAsync("import micropip\nawait micropip.install('openpyxl')\n_xlsx_ready = True"); }
    const proxy = py.globals.get('get_xlsx')(); const bytes = proxy.toJs(); proxy.destroy();
    download(`${baseName()}.xlsx`, [bytes], 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
  } catch (e) { fail(e); } finally { b.textContent = old; b.disabled = false; }
}

/* ---------------- Start ---------------- */
async function initPython() {
  setOverlay('Python-Laufzeit (Pyodide) wird geladen …', 10);
  py = await loadPyodide();
  setOverlay('numpy und pandas werden geladen …', 45);
  await py.loadPackage(['numpy', 'pandas', 'micropip']);
  setOverlay('Modell wird initialisiert …', 85);
  py.runPython($('#wind-model').textContent);
  return py;
}
async function init() {
  const yr = $('#wx-year'); for (let y = new Date().getFullYear() - 1; y >= 2005; y--) yr.add(new Option(y, y)); yr.value = '2025';
  $('#h-start').value = '2025-01-06';
  try {
    const [, [sites, anl]] = await Promise.all([initPython(), getData()]);
    SITES = sites; ANL = anl;
  } catch (e) {
    $('#ov-err').textContent = 'Fehler beim Start: ' + e.message + ' – Liegt der Ordner „data“ neben der HTML-Datei? Sonst bitte wind_sim_standalone.html verwenden. (Python wird aus dem Internet geladen.)';
    console.error(e); return;
  }
  const sel = $('#src'), groups = {};
  SITES.forEach(s => { (groups[s.group] ||= []).push(s); });
  Object.entries(groups).forEach(([g, list]) => { const og = document.createElement('optgroup'); og.label = g; list.forEach(s => og.appendChild(new Option(s.name, s.slug))); sel.appendChild(og); });
  const og = document.createElement('optgroup'); og.label = 'Weitere Standorte (Online-Abruf)'; og.appendChild(new Option('Eigener Standort (ERA5 über Open-Meteo)…', 'custom')); sel.appendChild(og);
  sel.value = 'Generisch';
  ANL.forEach(a => $('#type').add(new Option(a.name, a.id))); $('#type').value = 'generisch';
  TERRAINS.forEach(t => $('#terrain').add(new Option(`${fmt(t[0], t[0] < 0.01 ? 4 : 3)} m – ${t[1]}`, String(t[0])))); $('#terrain').add(new Option('Eigener Wert', 'custom'));
  $('#terrain').value = '0.1';
  applyType(); updateSketch();

  // Ereignisse
  $$('.inp').forEach(el => el.addEventListener('input', () => {
    if (el.id === 'hub') $('#hub-r').value = el.value; if (el.id === 'z0') syncTerrain();
    updateSketch(); scheduleRun(); }));
  $('#hub-r').addEventListener('input', e => { $('#hub').value = e.target.value; updateSketch(); scheduleRun(); });
  $('#terrain').addEventListener('change', e => { if (e.target.value !== 'custom') { $('#z0').value = e.target.value; scheduleRun(0); } });
  $('#type').addEventListener('change', () => { applyType(); scheduleRun(0); });
  $('#use100').addEventListener('change', () => { $('#href').disabled = $('#use100').checked; updateSketch(); scheduleRun(0); });
  $$('input[name=prof]').forEach(r => r.addEventListener('change', () => scheduleRun(0)));
  $('#src').addEventListener('change', loadSource);
  $('#wx-fetch').onclick = fetchOpenMeteo; $('#geo-btn').onclick = geocode;
  $('#geo-q').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); geocode(); } });
  $$('#tabs .tab').forEach(b => b.onclick = () => { activeTab = b.dataset.tab; $$('#tabs .tab').forEach(x => x.setAttribute('aria-selected', x === b));
    $$('.panel').forEach(p => p.classList.toggle('on', p.id === 'p-' + activeTab)); renderTab(activeTab);
    requestAnimationFrame(() => $$('#p-' + activeTab + ' .chart').forEach(c => { if (c.data) Plotly.Plots.resize(c); })); });
  $('#month-metric').onchange = () => { dirty.add('month'); renderTab('month'); };
  $('#day-metric').onchange = () => { dirty.add('day'); renderTab('day'); };
  $$('[data-csv]').forEach(b => b.onclick = () => downloadCsv(b.dataset.csv));
  $('#dl-kpi').onclick = downloadKpi; $('#dl-xlsx').onclick = downloadXlsx;
  const applyHour = () => { if (!res) return; const L = { xaxis3: {} }; setHourRange(L);
    Plotly.relayout('chart-hour', L.xaxis3.range ? { 'xaxis3.range': L.xaxis3.range } : { 'xaxis3.autorange': true }); };
  $$('#p-hour .chip').forEach(c => c.onclick = () => { $$('#p-hour .chip').forEach(x => x.classList.toggle('on', x === c)); applyHour(); });
  $('#h-start').addEventListener('change', applyHour);
  window.addEventListener('resize', () => $$('.panel.on .chart').forEach(c => { if (c.data) Plotly.Plots.resize(c); }));

  $('#overlay').style.display = 'none';
  await loadSource();
}
init();
</script>
</body>
</html>
