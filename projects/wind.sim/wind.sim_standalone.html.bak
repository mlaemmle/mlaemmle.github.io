    <div class="tablewrap" id="tbl-day"></div>
  </section>

  <!-- Stundenwerte -->
  <section class="panel panel-card" id="p-hour">
    <div class="toolbar">
      <div class="grp">
        <label for="h-start" class="lbl">Ab</label><input type="date" id="h-start">
        <button class="chip on" data-span="7" type="button">1 Woche</button>
        <button class="chip" data-span="31" type="button">1 Monat</button>
