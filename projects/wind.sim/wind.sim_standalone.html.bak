        <select id="day-metric">
          <option value="yield">Stromertrag [MWh]</option>
          <option value="wind">Ø Windgeschwindigkeit Nabenhöhe [m/s]</option>
          <option value="flh">Volllaststunden [h]</option>
          <option value="cf">Auslastungsfaktor [%]</option>
        </select></div>
      <div class="grp"><button class="btn" data-csv="daily" type="button" disabled>⬇ CSV</button></div>
